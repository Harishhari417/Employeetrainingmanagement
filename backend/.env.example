# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/employee_training?retryWrites=true&w=majority
MONGO_DB=employee_training

# JWT signing secret
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Frontend URL for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Initial HR/Admin account. This is created only when ADMIN_PASSWORD is supplied.
ADMIN_EMPLOYEE_ID=HR001
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=HR Administrator
ADMIN_DEPARTMENT=HR

# Email / SMTP
ADMIN_EMAIL=hr@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=your-email@example.com
SMTP_USE_TLS=true
VERIFICATION_CODE_EXPIRES_MINUTES=10
MONTHLY_REPORT_ENABLED=true
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_HOUR=9
JWT_ACCESS_TOKEN_EXPIRES=7200
